# Copia este archivo como .env (en tu PC) y pega los valores de tu proyecto:
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Solo en Vercel (Settings → Environment Variables). NUNCA en el código ni con VITE_ delante:
# SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-secreta
